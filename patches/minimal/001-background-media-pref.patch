From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MusicStream <dev@dnialify>
Subject: [PATCH 1/3] background media pref always-on for MusicStream

Port of Bare 0043, stripped to always-on for com.dnialify.musicstream.
Removes MediaSettingsFragment UI; OverrideWebPreferences always true on Android.

---
 chrome/browser/chrome_content_browser_client.cc          | 15 +++++++
 chrome/browser/prefs/browser_prefs.cc                    |  3 ++
 chrome/common/pref_names.h                               |  7 ++++
 third_party/blink/common/web_preferences/web_preferences_mojom_traits.cc | 2 ++
 third_party/blink/public/common/web_preferences/web_preferences.h        | 6 +++++
 third_party/blink/public/common/web_preferences/web_preferences_mojom_traits.h | 5 +++++
 third_party/blink/public/mojom/webpreferences/web_preferences.mojom     | 1 +
 third_party/blink/public/web/web_settings.h              | 3 +++
 third_party/blink/renderer/core/exported/web_settings_impl.cc | 4 ++++
 third_party/blink/renderer/core/exported/web_settings_impl.h  | 1 +
 third_party/blink/renderer/core/exported/web_view_impl.cc     | 2 ++
 third_party/blink/renderer/core/frame/settings.json5     | 5 +++++
 12 files changed, 54 insertions(+)

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -4595,6 +4595,16 @@ void ChromeContentBrowserClient::OverrideWebPreferences(
     WebContents* web_contents,
     content::SiteInstance& main_frame_site,
     blink::web_pref::WebPreferences* web_prefs) {
+#if BUILDFLAG(IS_ANDROID)
+  // MusicStream: dedicated shell — always allow background media.
+  // Bare original used allowlist + pref; we ship always-on.
+  web_prefs->background_media_playback_enabled = true;
+#endif
+
   Profile* profile =
       Profile::FromBrowserContext(web_contents->GetBrowserContext());
 
@@ -4960,6 +4970,11 @@ bool ChromeContentBrowserClient::OverrideWebPreferencesAfterNavigation(
   prefs_changed |= (web_prefs->autoplay_policy != autoplay_policy);
   web_prefs->autoplay_policy = autoplay_policy;
 
+#if BUILDFLAG(IS_ANDROID)
+  const bool bg = true;
+  prefs_changed |= (web_prefs->background_media_playback_enabled != bg);
+  web_prefs->background_media_playback_enabled = bg;
+#endif
+
 #if !BUILDFLAG(IS_ANDROID)

diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -2240,2 +2240,5 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
   registry->RegisterBooleanPref(prefs::kViewSourceLineWrappingEnabled, false);
+#if BUILDFLAG(IS_ANDROID)
+  registry->RegisterBooleanPref(prefs::kBackgroundMediaPlayback, false);
+#endif

diff --git a/chrome/common/pref_names.h b/chrome/common/pref_names.h
--- a/chrome/common/pref_names.h
+++ b/chrome/common/pref_names.h
@@ -334,2 +334,9 @@ inline constexpr char kWebKitForceDarkModeEnabled[] =
+inline constexpr char kBackgroundMediaPlayback[] =
+    "bare.background_media_playback";

diff --git a/third_party/blink/public/mojom/webpreferences/web_preferences.mojom b/third_party/blink/public/mojom/webpreferences/web_preferences.mojom
--- a/third_party/blink/public/mojom/webpreferences/web_preferences.mojom
+++ b/third_party/blink/public/mojom/webpreferences/web_preferences.mojom
@@ -388,1 +388,2 @@ struct WebPreferences {
   bool force_dark_mode_enabled;
+  bool background_media_playback_enabled;

diff --git a/third_party/blink/public/common/web_preferences/web_preferences.h b/third_party/blink/public/common/web_preferences/web_preferences.h
--- a/third_party/blink/public/common/web_preferences/web_preferences.h
+++ b/third_party/blink/public/common/web_preferences/web_preferences.h
@@ -316,1 +316,7 @@ struct BLINK_COMMON_EXPORT WebPreferences {
   bool force_dark_mode_enabled = false;
+  bool background_media_playback_enabled = false;

diff --git a/third_party/blink/public/web/web_settings.h b/third_party/blink/public/web/web_settings.h
--- a/third_party/blink/public/web/web_settings.h
+++ b/third_party/blink/public/web/web_settings.h
@@ -274,1 +274,4 @@ class WebSettings {
   virtual void SetForceDarkModeEnabled(bool) = 0;
+  virtual void SetBackgroundMediaPlaybackEnabled(bool) = 0;

diff --git a/third_party/blink/renderer/core/exported/web_settings_impl.cc b/third_party/blink/renderer/core/exported/web_settings_impl.cc
--- a/third_party/blink/renderer/core/exported/web_settings_impl.cc
+++ b/third_party/blink/renderer/core/exported/web_settings_impl.cc
@@ -769,2 +769,6 @@ void WebSettingsImpl::SetForceDarkModeEnabled(bool enabled) {
+void WebSettingsImpl::SetBackgroundMediaPlaybackEnabled(bool enabled) {
+  settings_->SetBackgroundMediaPlaybackEnabled(enabled);
+}
+

diff --git a/third_party/blink/renderer/core/exported/web_view_impl.cc b/third_party/blink/renderer/core/exported/web_view_impl.cc
--- a/third_party/blink/renderer/core/exported/web_view_impl.cc
+++ b/third_party/blink/renderer/core/exported/web_view_impl.cc
@@ -1862,1 +1862,3 @@ void WebView::ApplyWebPreferences(const web_pref::WebPreferences& prefs,
   settings->SetForceDarkModeEnabled(prefs.force_dark_mode_enabled);
+  settings->SetBackgroundMediaPlaybackEnabled(
+      prefs.background_media_playback_enabled);

diff --git a/third_party/blink/renderer/core/frame/settings.json5 b/third_party/blink/renderer/core/frame/settings.json5
--- a/third_party/blink/renderer/core/frame/settings.json5
+++ b/third_party/blink/renderer/core/frame/settings.json5
@@ -1039,1 +1039,6 @@
+    {
+      name: "backgroundMediaPlaybackEnabled",
+      initial: false,
+    },
